{
  "name": "vite-plugin-hmr-toast",
  "version": "0.1.0",
  "type": "module",
  "description": "Shows a small toast in the browser for every Vite hot update, CSS update and full reload.",
  "keywords": [
    "vite-plugin",
    "vite",
    "hmr",
    "toast",
    "devtools"
  ],
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "play": "pnpm build && pnpm --filter hmr-toast-playground dev",
    "test": "pnpm build && vitest run"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "vite": ">=5"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "happy-dom": "^21.0.4",
    "typescript": "7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
